# Copy to .env before running `docker compose up --build`.
# Replace the development values before exposing the service.
APP_ENV=development
MAINTENANCE_MODE=false
SECRET_KEY=GENERATE_NEW_32_CHAR_SECRET_HERE
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Docker Compose overrides the database and Redis URLs for its services.
DATABASE_URL=postgresql+psycopg://chatbot:chatbot@localhost:5432/chatbot
REDIS_URL=redis://localhost:6379/0
COOKIE_SECURE=false
ACCESS_TOKEN_MINUTES=15

PUBLIC_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Optional providers and integrations
GEMINI_API_KEY=
XKIRO_API_KEY=
XKIRO_API_URL=
OPENAI_API_KEY=
AI_PROVIDER_ORDER=gemini,xkiro
# Optional operator-supplied rates. Estimates use USD per million combined tokens.
GEMINI_COST_PER_MILLION_TOKENS_USD=0
XKIRO_COST_PER_MILLION_TOKENS_USD=0
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.invalid
SENTRY_DSN=
MONTHLY_AI_BUDGET=0

# Optional S3-compatible media storage
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=ap-south-1
